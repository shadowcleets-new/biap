<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher tile.

  Deliberately achromatic. The app's palette is generated from the device wallpaper at
  runtime, so any brand hue baked in here would contradict the theme on every phone but
  one. Ink lets the mark carry the identity and keeps the tile legible on any wallpaper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#12161C"
        android:pathData="M0,0h108v108h-108z" />
</vector>
