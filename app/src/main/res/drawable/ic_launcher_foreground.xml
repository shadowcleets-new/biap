<?xml version="1.0" encoding="utf-8"?>
<!--
  The BIAP mark - "Aperture" - as the launcher foreground.

  Same geometry as ui/BiapMark.kt, which draws it on a 64-unit grid, mapped onto the 108dp
  adaptive-icon viewport by

      viewport = 54 + (spec unit - 32) x 0.78

  WHY 0.78 AND NOT LARGER:
    An adaptive icon is 108dp, but the launcher's mask only reveals the inner 72dp, and it
    may be a circle. A SQUARE mark that fills the 72dp safe zone does not survive that mask
    - its corners sit 1.41x further from the centre than its edges, so they get sliced off.
    The mark is square, so what has to fit is its DIAGONAL, and the frame is STROKED, so
    half the stroke hangs outside the path as well:

      (28 half-side + 1.75 half-stroke) x 0.78 x 1.414 = 32.8

    against the 33dp radius Android guarantees visible under any mask shape. Sized to the
    safe square instead, the frame corners and the four nodes are cropped - which is exactly
    what was happening before. The generator asserts this distance, so a future nudge to the
    scale fails loudly rather than quietly clipping the mark again.

  Vector rather than exported bitmaps, so it is resolution-independent: at this device's
  420dpi the launcher draws it at 126px from geometry, never from a scaled-up PNG.

  The same file is the <monochrome> layer. For themed icons Android discards these colours
  and reads only the alpha, supplying its own from the wallpaper, so the two cannot drift.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Frame: spec inset 4, side 56, stroke 3.5, radius 3 -->
    <path
        android:strokeColor="#E9EEF4"
        android:strokeWidth="2.73"
        android:pathData="M34.5,32.16 H73.5 A2.34,2.34 0 0 1 75.84,34.5 V73.5 A2.34,2.34 0 0 1 73.5,75.84 H34.5 A2.34,2.34 0 0 1 32.16,73.5 V34.5 A2.34,2.34 0 0 1 34.5,32.16 Z" />

    <!-- Pinwheel: each bar starts where the previous one ends, so the four read as one
         rotating mechanism rather than four separate strokes. -->
    <path
        android:fillColor="#E9EEF4"
        android:pathData="M43.08,43.08 H60.24 V47.76 H43.08 Z M60.24,43.08 H64.92 V60.24 H60.24 Z M47.76,60.24 H64.92 V64.92 H47.76 Z M43.08,47.76 H47.76 V64.92 H43.08 Z" />

    <!-- Coordination nodes, held back so they read as connection points rather than as
         part of the mechanism itself. -->
    <path
        android:fillColor="#E9EEF4"
        android:fillAlpha="0.55"
        android:pathData="M52.44,32.16 H55.56 V35.28 H52.44 Z M72.72,52.44 H75.84 V55.56 H72.72 Z M52.44,72.72 H55.56 V75.84 H52.44 Z M32.16,52.44 H35.28 V55.56 H32.16 Z" />
</vector>
