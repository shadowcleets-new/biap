<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Package visibility for the phone sign-in fallback.

      Phone verification first asks Play Integrity to vouch for the app. A build installed
      over adb was never distributed by Google Play, so Play cannot recognise it and the
      server answers ALTERNATE_CLIENT_IDENTIFIER_REQUIRED. Firebase then falls back to a
      reCAPTCHA challenge, which it shows in a Custom Tab.

      Since Android 11 an app cannot see another app unless it declares the intent it wants
      to resolve. Without these two entries the browser lookup returns nothing, the challenge
      is never displayed, and the SDK quietly retries the request WITHOUT a verification
      token - which the server rejects as MISSING_CLIENT_IDENTIFIER. The visible symptom is
      "reCAPTCHA verification failed" even though every console setting is correct.

      androidx.browser carries this declaration from 1.5.0 onward; the version resolved here
      transitively is 1.4.0, which does not, so it is declared explicitly rather than left to
      depend on which version some other library happens to pull in.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!--
        enableOnBackInvokedCallback opts the whole app into predictive back.

        Without it the platform runs the legacy KeyEvent path, and NONE of the predictive
        behaviour exists - not the cross-activity peek at the home screen, not the system
        animations on dialogs and sheets, and not Navigation 3's own predictive pop, which
        is already implemented in the library and was simply never being asked for.

        Turning it on is also a promise: every back handler in the app must be an AndroidX
        one. onBackPressed() overrides stop being called on Android 13+ once this is true.
        This app only ever used androidx.activity.compose.BackHandler, so there was nothing
        to migrate.
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Biap">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
