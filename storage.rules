rules_version = '2';

// Cloud Storage is RETIRED. Design photos live in the user's own Google Drive
// appDataFolder (see DriveImageStore), and the firebase-storage dependency has been
// removed from the app entirely.
//
// The bucket previously allowed any authenticated user to read, write and delete under
// designs/**. Nothing used it any more, but the surface stayed live: this project is on
// the Blaze plan and anybody in the world can create an account through phone sign-up, so
// an unused-but-writable bucket was a free file host billed to the owner.
//
// Everything is denied. If Storage is ever reinstated, write explicit rules then rather
// than loosening these.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
