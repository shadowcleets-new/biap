rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Design photos. Keys are designs/{designId}/{millis}_{nonce}.{ext} and are
    // written once: replacing a photo uploads a NEW key rather than overwriting,
    // so a failed upload can never destroy the image a design still points at.
    match /designs/{designId}/{fileName} {

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Retention (keep newest 5) needs delete. request.resource is null on a
      // delete, so this rule cannot carry the size/type conditions above.
      allow delete: if request.auth != null;
    }

    // Anything outside /designs is denied by default - no catch-all required.
  }
}
